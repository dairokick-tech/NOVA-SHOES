# NEON: URL pooled para la API (hostname contiene -pooler); conservar sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler:5432/DATABASE?sslmode=require&channel_binding=require
# URL directa (sin -pooler), exclusiva para ejecutar migraciones
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&channel_binding=require
PORT=4000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000

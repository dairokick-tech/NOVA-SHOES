# Neon pooled URL for API runtime (host includes -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler:5432/DATABASE?sslmode=require&channel_binding=require
# Neon direct URL for schema migrations (non-pooler)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&channel_binding=require
PORT=4000
CORS_ORIGIN=http://localhost:5173,https://dairokick-tech.github.io
# Set both secrets only in the backend hosting provider; never commit actual values
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_BOOTSTRAP_KEY=replace-with-a-long-one-time-secret
NODE_ENV=production
VITE_API_URL=http://localhost:4000
